# Copy this file to .env and add your OpenRouter API key.
# Never commit .env or paste a real key into source code.
OPENROUTER_API_KEY=
OPENAI_URL=https://openrouter.ai/api/v1/chat/completions
OPENAI_MODEL=openai/gpt-4.1-mini

# Optional: false shows the Playwright browser; defaults to true.
PLAYWRIGHT_HEADLESS=true
