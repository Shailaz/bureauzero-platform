# Copy this file to .env and add your Gemini API key.
# Never commit .env or paste a real key into source code.
GEMINI_API_KEY=
# Optional alternate key variable supported by the Google Gen AI SDK.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: false shows the Playwright browser; defaults to true.
PLAYWRIGHT_HEADLESS=true
